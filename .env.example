# Copy to .env and edit. Every variable the application reads is listed here.

# Django secret key. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# Settings module: config.settings.dev (local work) or config.settings.prod (server)
DJANGO_SETTINGS_MODULE=config.settings.dev

# true only on a development machine. Never true on a server.
DEBUG=true

# Comma-separated host names the site answers to.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins allowed to POST forms (needed behind nginx/HTTPS), e.g. https://cnap.example.edu
CSRF_TRUSTED_ORIGINS=

# PostgreSQL connection. With docker compose the host is "db".
DATABASE_URL=postgres://cnap:cnap@db:5432/cnap

# Where uploaded files are stored. A volume in docker compose.
MEDIA_ROOT=/data/media

# Time zone used for due dates and display. Stored values are UTC.
TIME_ZONE=America/Chicago

# Single sign-on. Leave false until K-State IT approves and configures it (docs/sso.md).
SSO_ENABLED=false

# Means for groups smaller than this are hidden from audiences without the confidential permission.
SMALL_N_THRESHOLD=5

# Links in e-mails, and the sender
SITE_URL=https://cnap-hub.k-state.edu
DEFAULT_FROM_EMAIL=CNAP Reporting Hub <no-reply@k-state.edu>
# Mail server (K-State relay). Production refuses to start without it.
EMAIL_URL=smtp+tls://user:password@smtp.example.k-state.edu:587
# Emailed sign-in links for K-State people too (default: until SSO_ENABLED is true). Outside people always use links.
# SIGNIN_LINKS_FOR_KSTATE=true
# Publications and grants: reminder after this many days without a review; at most one reminder per period of days
OUTCOME_STALE_DAYS=120
OUTCOME_REMINDER_EVERY_DAYS=30
# CNAP's grant number(s), comma-separated, to check PubMed's grant index
CNAP_GRANT_NUMBERS=P20GM113109
PUBMED_CONTACT_EMAIL=
