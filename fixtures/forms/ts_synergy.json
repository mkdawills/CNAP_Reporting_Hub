          "prompt": "I find it easy to speak up in the business meetings.",
          "type": "likert",
          "answer_set": "Agreement (Team Science)",
          "measure": "ts_synergy_07",
          "required": true
        },
        {
          "code": "item_08",
          "prompt": "Being a part of CNAP has enhanced my level of research productivity.",
          "type": "likert",
          "answer_set": "Agreement (Team Science)",
          "measure": "ts_synergy_08",
