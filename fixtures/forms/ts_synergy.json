          "answer_set": "Agreement (Team Science)",
          "measure": "ts_synergy_04",
          "required": true
        },
        {
          "code": "item_05",
          "prompt": "Trust among CNAP members does not need to be improved.",
          "type": "likert",
          "answer_set": "Agreement (Team Science)",
          "measure": "ts_synergy_05",
          "required": true
        },
        {
