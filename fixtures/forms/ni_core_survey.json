    "short_name": "NI Core",
    "about": [
      "The Neuroinformatics Core provides shared computing and data storage on Beocat, classes and online help, and technical support from core staff.",
      "This survey asks how well those resources supported your research, and how often you used them."
    ],
    "opt_out": {
      "question": "optout",
      "short": "Didn’t use this core"
    }
  },
  "sections": [
